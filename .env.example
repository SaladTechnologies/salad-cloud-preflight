# Docker --env-file format; no shell sourcing or automatic .env loading.
# Empty thresholds mean no check. Set thresholds from measurements of your app.
SALAD_PREFLIGHT_DRY_RUN=true
SALAD_PREFLIGHT_UNKNOWN_POLICY=continue
SALAD_PREFLIGHT_STARTUP_TIMEOUT=120s
SALAD_PREFLIGHT_PROBE_TIMEOUT=15s
SALAD_PREFLIGHT_IMDS_TIMEOUT=5s
SALAD_PREFLIGHT_ATTEMPTS=3
SALAD_PREFLIGHT_FAIL_CONFIRMATIONS=2
SALAD_PREFLIGHT_RETRY_DELAY=1s
SALAD_PREFLIGHT_GPU=0
SALAD_PREFLIGHT_NVIDIA_SMI=nvidia-smi
SALAD_PREFLIGHT_MULTIPLE_FAILURE_REASON=Multiple startup requirements not met

# Empty ENABLED automatically enables the check when its threshold is configured.
# Explicit false overrides a configured threshold; true requires a threshold.
# MIN keys reject values below the threshold; MAX keys reject values above it.
SALAD_PREFLIGHT_GPU_TOTAL_ENABLED=
SALAD_PREFLIGHT_GPU_TOTAL_MIN_MIB=
SALAD_PREFLIGHT_GPU_TOTAL_REASON=GPU total VRAM below minimum
SALAD_PREFLIGHT_GPU_FREE_ENABLED=
SALAD_PREFLIGHT_GPU_FREE_MIN_MIB=
# Use either MIN_MIB or MIN_PERCENT, not both. Percent = free / total * 100.
SALAD_PREFLIGHT_GPU_FREE_MIN_PERCENT=
SALAD_PREFLIGHT_GPU_FREE_REASON=GPU free VRAM below minimum
SALAD_PREFLIGHT_GPU_POWER_ENABLED=
SALAD_PREFLIGHT_GPU_POWER_MIN_WATTS=
# Use either MIN_WATTS or MIN_PERCENT. Percent = power.limit / reference * 100.
SALAD_PREFLIGHT_GPU_POWER_MIN_PERCENT=
SALAD_PREFLIGHT_GPU_POWER_REFERENCE=default
SALAD_PREFLIGHT_GPU_POWER_REASON=GPU power limit below minimum
# Versions are one to three dotted numbers, such as 12.8 or 550.54.14.
SALAD_PREFLIGHT_GPU_DRIVER_ENABLED=
SALAD_PREFLIGHT_GPU_DRIVER_MIN_VERSION=
SALAD_PREFLIGHT_GPU_DRIVER_REASON=GPU driver version below minimum
SALAD_PREFLIGHT_GPU_CUDA_ENABLED=
SALAD_PREFLIGHT_GPU_CUDA_MIN_VERSION=
SALAD_PREFLIGHT_GPU_CUDA_REASON=CUDA version below minimum
SALAD_PREFLIGHT_GPU_UTILIZATION_ENABLED=
SALAD_PREFLIGHT_GPU_UTILIZATION_MAX_PERCENT=
SALAD_PREFLIGHT_GPU_UTILIZATION_REASON=GPU utilization above maximum
SALAD_PREFLIGHT_GPU_TEMPERATURE_ENABLED=
SALAD_PREFLIGHT_GPU_TEMPERATURE_MAX_CELSIUS=
SALAD_PREFLIGHT_GPU_TEMPERATURE_REASON=GPU temperature above maximum

# Median TCP connect time to host:port, for example your storage endpoint on 443.
SALAD_PREFLIGHT_LATENCY_ENABLED=
SALAD_PREFLIGHT_LATENCY_MAX_MS=
SALAD_PREFLIGHT_LATENCY_REASON=Network latency above maximum
SALAD_PREFLIGHT_LATENCY_ADDRESS=
SALAD_PREFLIGHT_LATENCY_SAMPLES=5

SALAD_PREFLIGHT_DOWNLOAD_ENABLED=
SALAD_PREFLIGHT_DOWNLOAD_MIN_MBPS=
SALAD_PREFLIGHT_DOWNLOAD_REASON=Download bandwidth below minimum
SALAD_PREFLIGHT_DOWNLOAD_URL=
SALAD_PREFLIGHT_DOWNLOAD_BYTES=25000000
SALAD_PREFLIGHT_DOWNLOAD_SHA256=
SALAD_PREFLIGHT_DOWNLOAD_BEARER_TOKEN=

SALAD_PREFLIGHT_UPLOAD_ENABLED=
SALAD_PREFLIGHT_UPLOAD_MIN_MBPS=
SALAD_PREFLIGHT_UPLOAD_REASON=Upload bandwidth below minimum
SALAD_PREFLIGHT_UPLOAD_URL=
SALAD_PREFLIGHT_UPLOAD_BYTES=25000000
SALAD_PREFLIGHT_UPLOAD_BEARER_TOKEN=

# One executable, no arguments, that prints a single number; higher is better.
SALAD_PREFLIGHT_BENCHMARK_ENABLED=
SALAD_PREFLIGHT_BENCHMARK_MIN_SCORE=
SALAD_PREFLIGHT_BENCHMARK_REASON=Benchmark score below minimum
SALAD_PREFLIGHT_BENCHMARK_COMMAND=
SALAD_PREFLIGHT_BENCHMARK_TIMEOUT=60s
